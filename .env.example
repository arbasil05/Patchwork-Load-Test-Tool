# Patchwork Load Tester – environment configuration example
# Copy this file to .env and adjust as needed.

# Address Express listens on (default: 127.0.0.1)
LISTEN_HOST=127.0.0.1

# Port Express listens on (default: 3000)
PORT=3000

# Base URL used inside every callback payload.
# If Patchwork runs inside Docker, set this to a host-reachable address
# (e.g. http://172.17.0.1:3000 or use docker0 bridge IP).
# Containers on Linux cannot reach 127.0.0.1 on the host by default.
CALLBACK_BASE_URL=http://127.0.0.1:3000

# Absolute path to the k6 binary (optional – defaults to PATH lookup)
# K6_BIN=/usr/bin/k6

# SQLite database path (default: <project>/data/loadtest.sqlite)
# DB_PATH=/home/basil/Load_Testing_App/data/loadtest.sqlite

# Maximum allowed concurrency (default: 500)
# MAX_CONCURRENCY=500

# Log level: error | warn | info | debug (default: info)
# LOG_LEVEL=info
